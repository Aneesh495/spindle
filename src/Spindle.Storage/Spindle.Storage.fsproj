  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spindle.Core\Spindle.Core.fsproj" />
    <ProjectReference Include="..\Spindle.Engine\Spindle.Engine.fsproj" />
  </ItemGroup>

</Project>
